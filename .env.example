# Copy to .env (never commit .env) and fill in. All are optional: without them PingFarm
# runs in a safe offline mode (extractive answers, WhatsApp dry-run, no price lookup).

# Answer writer, option 1 (free tier): Gemini key from https://aistudio.google.com/apikey
# If both keys are set, Gemini is used.
GEMINI_API_KEY=
PINGFARM_GEMINI_MODEL=gemini-3.8-flash

# Answer writer, option 2 (https://console.anthropic.com). Without any key, replies quote the sources directly.
ANTHROPIC_API_KEY=
PINGFARM_MODEL=claude-haiku-5-5

# Mandi prices (free key: https://data.gov.in)
DATA_GOV_API_KEY=

# Telegram bot (free, no business verification, no public address needed): make one with @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp through Twilio's sandbox (https://console.twilio.com): the quickest way to show the bot on a real phone,
# no business verification needed. The auth token also signs every request Twilio sends us.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp Cloud API (https://developers.facebook.com, WhatsApp product, test number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Replace the next value with your own random string (about 20 letters); Meta asks for the same string
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
# Required: without the app secret every webhook request is rejected (so nobody can post fake messages)
WHATSAPP_APP_SECRET=
