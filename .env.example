# Copy to .env (never commit .env) and fill in. All are optional: without them PingFarm
# runs in a safe offline mode (extractive answers, WhatsApp dry-run, no price lookup).

# Answer writer (https://console.anthropic.com). Without it, replies quote the sources directly.
ANTHROPIC_API_KEY=
PINGFARM_MODEL=claude-haiku-5-5

# Mandi prices (free key: https://data.gov.in)
DATA_GOV_API_KEY=

# WhatsApp Cloud API (https://developers.facebook.com, WhatsApp product, test number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_APP_SECRET=
